{
  "permissions": {
    "allow": [
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * --delete*)",
      "Bash(git push * --mirror*)"
    ]
  }
}
